includes:
    - vendor/larastan/larastan/extension.neon

rules:
    - Fonid\Analysis\PersonalData\PersonalDataMustNotLeakRule

parameters:
    level: max
    paths:
        - analysis
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests
    excludePaths:
        - bootstrap/cache
        # Fixture for the rule's own test: breaks the rule on purpose.
        - tests/Architecture/PersonalData/Fixtures
